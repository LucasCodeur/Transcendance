// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

model User {
  id        Int               @id(map: "User_pkey") @default(autoincrement())
  createdAt TimestamptzString @default(now())
  email     String            @unique(map: "User_email_key")
  name      String?
  updatedAt TimestamptzString
  username  String?
  posts     Post[]
}

model Post {
  id        Int               @id(map: "Post_pkey") @default(autoincrement())
  authorId  Int
  content   String?
  createdAt TimestamptzString @default(now())
  title     String
  updatedAt TimestamptzString
  author    User              @relation(fields: [authorId], references: [id], onDelete: Cascade, map: "Post_authorId_fkey")

  @@index([authorId], name: "Post_authorId_idx")
}

model Medecin {
  id             String           @id @default(cuid(2))
  name           String?
  patientMedecin PatientMedecin[]
}

model Patient {
  id             String           @id @default(cuid(2))
  name           String?
  patientMedecin PatientMedecin[]
}

model PatientMedecin {
  medecinId String
  patientId String
  medecin   Medecin @relation(fields: [medecinId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([medecinId, patientId])
}
