// use prisma-8
model User {
  id            String            @id @default(uuid())
  email         String            @unique
  displayName   String
  passwordHash  String?
  emailVerified Boolean           @default(false)
  totpSecret    String?
  friends		User[] @relation("friend")
  sessions      Session[]
  organizations Organization[]
  oauthAccounts OAuthAccount[]
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()
}

enum FriendStatus {
	@@type("pg/text@1")
	Pending = "pending"
	Accepted = "accepted"
}

model Friend {
	userId		String
	friendId	String
	user		User	@relation("friend", fields: [userId], references:[id]) // ok my first idea was to put "friend" on the other one, but in the way i thought this model, it seems that friend must be here ...
	friend		User	@relation(fields: [friendId], references:[id])
	type		FriendStatus @default(Pending)
	@@id([userId, friendId])
}
// what is type ? pending, friend, accept ?

model Message {
	messageId	String @id @default(uuid())
	senderId	String
	receiverId	String
	content		String
	timestamp	TimestamptzString @default(now())
}

model Organization {
	id		String	@id @default(uuid())
	name	String	@unique
	users	User[]
}

enum Role {
	@@type("pg/text@1")
	Owner = "owner"
	Editor = "editor"
	Contributor = "contributor"
	Viewer = "viewer"
}

model UserOrganizations {
	userId			String
	organizationId	String
	user			User @relation(fields: [userId], references:[id])
	organization	Organization @relation(fields: [organizationId], references:[id])
	role			Role @default(Viewer)
	@@id([userId, organizationId])
}

model Session {
  id          String            @id
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   TimestamptzString
  totpPending Boolean           @default(false)
  createdAt   TimestamptzString @default(now())
  @@index([userId])
}

model OAuthAccount {
  id                String            @id @default(uuid())
  provider          String
  providerUserId    String
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         TimestamptzString @default(now())
  @@unique([provider, providerUserId])
  @@unique([userId, provider])
}
