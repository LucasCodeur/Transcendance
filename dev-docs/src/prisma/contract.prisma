// use prisma-8

// Platform user account
model User {
  id String @id @default(cuid(2))
}

// Active session with a hashed token
model Session {
  id String @id @default(cuid(2))
}

// External identity linked to a user
model OAuthAccount {
  id String @id @default(cuid(2))
}

// Family organization
model Organization {
  id String @id @default(cuid(2))
}

// User membership in an organization with a role
model Membership {
  id String @id @default(cuid(2))
}

namespace genealogy {
  // Family tree belonging to an organization
  model Tree {
    id String @id @default(cuid(2))
  }

  // Individual in a family tree
  model Person {
    id            String @id @default(cuid(2))
    gender        String
    firstName     String
    middleName    String?
    lastName      String
    maidenName    String?
    marriedName   String?
    birthDate     TimestamptzString?
    birthPlace    String
    deceased      Boolean 
    deathDate     TimestamptzString?
    deathPlace    String?
  }

  // Partnership between individuals, including type and start/end dates
  model Partnership {
    id String @id @default(cuid(2))
  }

  // Links a person to a partnership
  model PartnerLink {
    id String @id @default(cuid(2))
  }

  // Links a child to a partnership with a parentage type
  model ChildLink {
    id String @id @default(cuid(2))
  }

  // Media file attached to a person
  model Media {
    id String @id @default(cuid(2))
  }
}

// Family group chat or direct conversation
  model Conversation {
    id String @id @default(cuid(2))
  }

  // Message within a conversation
  model Message {
    id String @id @default(cuid(2))
  }

  // Notification intended for a user
  model Notification {
    id String @id @default(cuid(2))
  }
