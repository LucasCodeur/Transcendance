// use prisma-8

namespace genealogy {

// Family tree belonging to an organization
model Tree {
  id      String   @id @default(cuid(2))
  name    String
  persons Person[]
}

// Individual in a family tree
model Person {
  id String @id @default(cuid(2))

  // WARN: to change
  gender      String
  firstName   String
  middleName  String?
  lastName    String?
  maidenName  String?
  marriedName String?
  birthDate   TimestamptzString
  birthPlace  String
  deceased    Boolean
  deathDate   TimestamptzString?
  deathPlace  String?

  treeId String
  tree   Tree   @relation(fields: [treeId], references: [id])

  medias      Media[]
  partnerLink PartnerLink[]
  childLink   ChildLink[]
}

// Partnership between individuals, including type and start/end dates
model Partnership {
  id          String        @id @default(cuid(2))
  type        String
  partnerLink PartnerLink[]
  childLink   ChildLink[]
}

// Links a person to a partnership
model PartnerLink {
  id String @id @default(cuid(2))

  personId String
  person   Person @relation(fields: [personId], references: [id])

  partnershipId String
  partnerShip   Partnership @relation(fields: [partnershipId], references: [id])
}

// Links a child to a partnership with a parentage type
model ChildLink {
  id   String @id @default(cuid(2))
  type String

  personId String
  person   Person @relation(fields: [personId], references: [id])

  partnershipId String
  partnerShip   Partnership @relation(fields: [partnershipId], references: [id])
}

// Media file attached to a person
model Media {
  id       String @id @default(cuid(2))
  personId String
  person   Person @relation(fields: [personId], references: [id])
}

}

// Family group chat or direct conversation
model Conversation {
  id String @id @default(cuid(2))
}

// Message within a conversation
model Message {
  id String @id @default(cuid(2))
}

// Notification intended for a user
model Notification {
  id String @id @default(cuid(2))
}
