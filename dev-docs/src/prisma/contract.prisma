// use prisma-8
model User {
  id            String            @id @default(uuid())
  email         String            @unique
  displayName   String
  avatarId      String?           @unique
  avatar        Media?            @relation("UserAvatar", fields: [avatarId], references: [id], onDelete: SetNull)
  passwordHash  String?
  emailVerified Boolean           @default(false)
  totpSecret    String?
  totpLastStep  Int?
  sessions      Session[]
  oauthAccounts OAuthAccount[]
  recoveryCodes RecoveryCode[]
  media         Media[]           @relation("MediaOwner")
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()
}

model Session {
  id          String            @id
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   TimestamptzString
  totpPending Boolean           @default(false)
  createdAt   TimestamptzString @default(now())
  @@index([userId])
}

model OAuthAccount {
  id                String            @id @default(uuid())
  provider          String
  providerUserId    String
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         TimestamptzString @default(now())
  @@unique([provider, providerUserId])
  @@unique([userId, provider])
}

model RecoveryCode {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  createdAt TimestamptzString @default(now())
  @@unique([userId, codeHash])
}

model Media {
  id              String                     @id @default(uuid())
  ownerId         String
  owner           User                       @relation("MediaOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  kind            String
  mimeType        String
  size            Int
  storageKey      String                     @unique
  createdAt       TimestamptzString          @default(now())
  avatarOf        User?                      @relation("UserAvatar")
  @@index([ownerId])
}
