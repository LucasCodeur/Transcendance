// use prisma-8
namespace genealogy {

// Family tree belonging to an organization
model Tree {
  id      String   @id @default(cuid(2))
  name    String
  persons Person[]
}

// Individual in a family tree
model Person {
  id            String @id @default(cuid(2))
  gedcomId      String?

  gender        String?

  fullName      String?
  givenName     String?
  surName       String?

  nickName      String?
  maidenName    String?
  marriedName   String?

  birthDate     TimestamptzString?
  birthPlace    String?
  birthAdress   String?

  deceased      Boolean?

  deathDate     TimestamptzString?
  deathPlace    String?

  treeId        String
  tree          Tree @relation(fields: [treeId], references: [id])

  medias        Media[]?

  partnerLinks  PartnerLink[]?
  childLinks    ChildLink[]?
}

// Partnership between individuals, including type and start/end dates
model Partnership {
  id              String        @id @default(cuid(2))
  treeId          String
  gedcomId        String?

  partnerLinks    PartnerLink[]
  childLinks      ChildLink[]
}

// Links a person to a partnership
model PartnerLink {
  id              String @id @default(cuid(2))
  personId        String
  gedcomId        String?

  person          Person @relation(fields: [personId], references: [id])

  partnershipId   String
  partnerShip     Partnership @relation(fields: [partnershipId], references: [id])

  type            String?
}

// Links a child to a partnership with a parentage type
model ChildLink {
  id              String @id @default(cuid(2))
  personId        String
  gedcomId        String?

  person          Person @relation(fields: [personId], references: [id])

  partnershipId   String
  partnerShip     Partnership @relation(fields: [partnershipId], references: [id])
}

// Media file attached to a person
model Media {
  id              String @id @default(cuid(2))
  personId        String
  person          Person @relation(fields: [personId], references: [id])
}

}

// Family group chat or direct conversation
model Conversation {
  id String @id @default(cuid(2))
}

// Notification intended for a user
model Notification {
  id String @id @default(cuid(2))
}

model User {
  id            String            @id @default(uuid())
  email         String            @unique
  displayName   String
  avatarId      String?           @unique
  avatar        Media?            @relation("UserAvatar", fields: [avatarId], references: [id], onDelete: SetNull)
  passwordHash  String?
  emailVerified Boolean           @default(false)
  totpSecret    String?
  friends		User[] @relation("friend")
  messages		Message[]
  totpLastStep  Int?
  sessions      Session[]
  organizations Organization[]
  oauthAccounts OAuthAccount[]
  recoveryCodes RecoveryCode[]
  media         Media[]           @relation("MediaOwner")
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()
}

enum FriendStatus {
	@@type("pg/text@1")
	Pending = "pending"
	Accepted = "accepted"
}

model Friend {
	userId		String
	friendId	String
	user		User	@relation("friend", fields: [userId], references:[id]) // ok my first idea was to put "friend" on the other one, but in the way i thought this model, it seems that friend must be here ...
	friend		User	@relation(fields: [friendId], references:[id])
	type		FriendStatus @default(Pending)
	@@id([userId, friendId])
}
// what is type ? pending, friend, accept ?

model Message {
	messageId	String	@id @default(uuid())
	user		User	@relation(fields: [senderId], references:[id])
	senderId	String
	receiverId	String
	content		String
	timestamp	TimestamptzString @default(now())
}

model Organization {
	id		String	@id @default(uuid())
	name	String	@unique
	users	User[]
}

enum Role {
	@@type("pg/text@1")
	Owner = "owner"
	Editor = "editor"
	Contributor = "contributor"
	Viewer = "viewer"
}

model UserOrganizations {
	userId			String
	organizationId	String
	user			User @relation(fields: [userId], references:[id])
	organization	Organization @relation(fields: [organizationId], references:[id])
	role			Role @default(Viewer)
	@@id([userId, organizationId])
}

model Session {
  id          String            @id
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   TimestamptzString
  totpPending Boolean           @default(false)
  createdAt   TimestamptzString @default(now())
  @@index([userId])
}

model OAuthAccount {
  id                String            @id @default(uuid())
  provider          String
  providerUserId    String
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         TimestamptzString @default(now())
  @@unique([provider, providerUserId])
  @@unique([userId, provider])
}

model RecoveryCode {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  createdAt TimestamptzString @default(now())
  @@unique([userId, codeHash])
}

model Media {
  id              String                     @id @default(uuid())
  ownerId         String
  owner           User                       @relation("MediaOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  kind            String
  mimeType        String
  size            Int
  storageKey      String                     @unique
  createdAt       TimestamptzString          @default(now())
  avatarOf        User?                      @relation("UserAvatar")
  @@index([ownerId])
}
