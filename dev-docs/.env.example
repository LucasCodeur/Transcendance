# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=prisma
# DATABASE_URL="postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@localhost:5432/$POSTGRES_DB"
# this line up here does not works with npx prisma db init, what a great world ...
DATABASE_URL="postgresql://postgres:prisma@localhost:5432/postgres"
ORIGIN="http://localhost:4343"
FORTYTWO_CLIENT_ID=""
FORTYTWO_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
TOTP_ENCRYPTION_KEY=""
UPLOAD_DIR="./uploads"
