{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "paths": {
      "#prisma/*": ["./src/prisma/*"]
    },
    "strict": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["node", "$app/types"]
  },
  "include": ["src", "vite.config.ts"]
}
